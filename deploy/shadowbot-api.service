[Unit]
Description=ShadowBot Shop API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Поправь путь, если репозиторий живёт в другом месте
WorkingDirectory=/opt/shadowbot
# Секреты берутся из /opt/shadowbot/.env (см. load_dotenv в server/config.py)
ExecStart=/opt/shadowbot/server/.venv/bin/python -m uvicorn server.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
