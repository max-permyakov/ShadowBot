# Скопируй в .env и заполни

# Токен бота от @BotFather
BOT_TOKEN=

# Кому приходят заказы (юзернейм производителя без @)
OWNER_USERNAME=

# Telegram ID администраторов через запятую
# (узнать свой ID: /id в боте или @userinfobot)
ADMIN_IDS=

# https-адрес мини-аппа, например https://shop.example.com
# (используется ботом для кнопки «Открыть магазин»)
MINIAPP_URL=

# Заполнить каталог демо-карточками при первом запуске (0/1)
SEED_DEMO=1
